GROQ_API_KEY=your_key_here

# Jira OAuth 2.0 (3LO) - all six are required; the server refuses to start without them.
JIRA_CLIENT_ID=your_atlassian_client_id
JIRA_CLIENT_SECRET=your_atlassian_client_secret
# Must exactly match a Callback URL in your Atlassian app's Authorization settings.
JIRA_REDIRECT_URI=http://localhost:8000/api/jira/callback
# Origin of the page that opens the popup (scheme + host[:port], no path).
FRONTEND_ORIGIN=http://localhost:8000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET=generate_a_fernet_key
# "local" (http, cookies not Secure) or "prod" (https, cookies Secure)
APP_ENV=local
